{
  "name": "beirutmediapro-site",
  "compatibility_date": "2024-09-01",
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Daily refresh of the long-lived Instagram token (needs REELS_KV below).
  "triggers": { "crons": ["17 3 * * *"] }
  // To enable auto token refresh, create a KV namespace and add:
  // "kv_namespaces": [{ "binding": "REELS_KV", "id": "<namespace id>" }]
}
